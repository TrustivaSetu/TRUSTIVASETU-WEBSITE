#!/usr/bin/env python3

from pathlib import Path
import json
import sys

REQUIRED_FIELDS = ["slug", "key", "metadata", "landing"]
REQUIRED_METADATA = ["title", "description", "ogTitle", "ogDescription"]
REQUIRED_LANDING = [
    "title",
    "description",
    "heroTitle",
    "heroSubtitle",
    "treatments",
    "faqs",
]

if len(sys.argv) != 2:
    print("Usage:")
    print("python3 scripts/generate-landing-v3.py <page-key>")
    sys.exit(1)

page_key = sys.argv[1]

json_file = Path(f"data/landing-content/{page_key}.json")
template_file = Path("templates/landing-page.tsx.template")
preview_dir = Path("generated")

if not json_file.exists():
    print(f"❌ JSON not found: {json_file}")
    sys.exit(1)

if not template_file.exists():
    print(f"❌ Template not found: {template_file}")
    sys.exit(1)

data = json.loads(json_file.read_text())

for field in REQUIRED_FIELDS:
    if field not in data:
        print(f"❌ Missing field: {field}")
        sys.exit(1)

for field in REQUIRED_METADATA:
    if field not in data["metadata"]:
        print(f"❌ Missing metadata.{field}")
        sys.exit(1)

for field in REQUIRED_LANDING:
    if field not in data["landing"]:
        print(f"❌ Missing landing.{field}")
        sys.exit(1)

if not isinstance(data["landing"]["treatments"], list) or not data["landing"]["treatments"]:
    print("❌ landing.treatments must be a non-empty array")
    sys.exit(1)

for i, item in enumerate(data["landing"]["treatments"], start=1):
    if "title" not in item or "description" not in item:
        print(f"❌ Invalid treatment #{i}")
        sys.exit(1)

if not isinstance(data["landing"]["faqs"], list) or not data["landing"]["faqs"]:
    print("❌ landing.faqs must be a non-empty array")
    sys.exit(1)

for i, item in enumerate(data["landing"]["faqs"], start=1):
    if "question" not in item or "answer" not in item:
        print(f"❌ Invalid FAQ #{i}")
        sys.exit(1)

target_dir = Path("app") / data["slug"]
target_file = target_dir / "page.tsx"

if target_file.exists():
    print(f"❌ Target already exists: {target_file}")
    print("Generation stopped to avoid overwriting an existing page.")
    sys.exit(1)

template = template_file.read_text()

function_name = "".join(
    word.capitalize()
    for word in page_key.replace("-", " ").split()
) + "Page"

replacements = {
    "__TITLE__": data["metadata"]["title"],
    "__DESCRIPTION__": data["metadata"]["description"],
    "__CANONICAL__": f"https://trustivasetu.com/{data['slug']}",
    "__OG_TITLE__": data["metadata"]["ogTitle"],
    "__OG_DESCRIPTION__": data["metadata"]["ogDescription"],
    "__FUNCTION_NAME__": function_name,
    "__KEY__": data["key"],
}

for old, new in replacements.items():
    template = template.replace(old, new)

preview_dir.mkdir(exist_ok=True)

output_file = preview_dir / f"{data['slug']}-page.tsx"
output_file.write_text(template)

print("✅ JSON validation passed")
print(f"✅ Treatments : {len(data['landing']['treatments'])}")
print(f"✅ FAQs       : {len(data['landing']['faqs'])}")
print(f"✅ Preview    : {output_file}")
print("✅ Existing pages are protected from overwrite.")
