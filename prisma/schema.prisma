// TrustivaSetu Website — CMS Database Schema
// Separate Neon Postgres DB from the LMS (do not point this at trustiva-lms-db).
// Run: npx prisma db push   (use db push, not migrate, to match your LMS convention)
 
generator client {
  provider = "prisma-client-js"
}
 
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
// ---------- Admin login (you + Ajit only) ----------
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
 
// ---------- Blog / Articles ----------
model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  coverImage  String? // S3 URL
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
 
// ---------- Testimonials ----------
model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String? // e.g. "Owner, Divine Health Clinic"
  quote       String   @db.Text
  photoUrl    String? // S3 URL
  published   Boolean  @default(true)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
}
 
// ---------- Team members ----------
model TeamMember {
  id           String  @id @default(cuid())
  name         String
  designation  String
  bio          String? @db.Text
  photoUrl     String?
  linkedinUrl  String?
  displayOrder Int     @default(0)
  published    Boolean @default(true)
}
 
// ---------- Curated public clinic list (NOT the full LMS Clinic table) ----------
// Populate this manually or via a small sync script from the LMS DB —
// never point the website directly at the LMS database.
model PublicClinic {
  id           String  @id @default(cuid())
  name         String
  city         String
  specialty    String // e.g. "IVF & Fertility"
  logoUrl      String?
  displayOrder Int     @default(0)
  published    Boolean @default(true)
}
 
// ---------- Contact / Enquiry form submissions ----------
model Enquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  clinicName String?
  message   String?  @db.Text
  source    String? // which page/form the enquiry came from
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
